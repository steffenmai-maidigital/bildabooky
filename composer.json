{
    "name": "bildabooky/bildabooky",
    "type": "project",
    "description": "BilDaBooky – Freie, selbst gehostete Buch-Werkstatt für Schüler (Laravel, Docker, SQLite)",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "bacon/bacon-qr-code": "^3.0",
        "league/commonmark": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
